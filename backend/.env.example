# 金融产品解析智能体后端环境变量示例
# 复制为 .env 后填写实际值，勿提交 .env

# ----- 应用 -----
APP_ENV=development
PORT=8000
# INFO 为默认；设为 DEBUG 可看到密码校验等详细日志
LOG_LEVEL=DEBUG
# 可选：日志同时写入文件（路径相对 backend 或绝对路径）；不设则仅控制台
# LOG_FILE=logs/app.log

# ----- MySQL（会话、配置、FAQ、反馈、审计索引） -----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=fpai
# 连接池大小，0 表示不启用池（每次新建连接）
MYSQL_POOL_SIZE=0

# ----- Redis（会话上下文、缓存、限流、幂等） -----
# 可选：直接写 REDIS_URL 覆盖下面分项
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_MAX_CONNECTIONS=20
# 键约定 T005：会话/缓存/限流/幂等 TTL 与上限（秒）
REDIS_SESSION_TTL_SECONDS=1800
REDIS_PRODUCT_CACHE_TTL_SECONDS=600
REDIS_RETRIEVAL_CACHE_TTL_SECONDS=600
REDIS_RATELIMIT_WINDOW_SECONDS=60
REDIS_RATELIMIT_CHAT_MAX=60
REDIS_IDEMPOTENT_TTL_SECONDS=300

# ----- Milvus（向量库） -----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=fpai_chunks

# ----- MinIO（对象存储：文档、审计冷数据） -----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_DOCS=fpai-docs
MINIO_BUCKET_AUDIT=fpai-audit

# ----- 模型与推理（内网地址，统一大模型审查与 RAG） -----
# LLM（Qwen3/DeepSeekV3）
# 使用阿里云 DashScope（灵积）时：留空 LLM_BASE_URL，只填 LLM_API_KEY 或 DASHSCOPE_API_KEY，否则易报 "url error"。
# 自建/代理网关时：填写完整的 OpenAI 兼容 base_url，如 https://your-gateway.com/v1，勿带多余路径或尾斜杠。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-max
# LLM/AgentScope 推理参数（temperature、max_tokens）
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000

# Embedding（BGE-M3/BGE-LARGE-ZH）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3

# Reranker（BGE-RERANKER-LARGE）
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=bge-reranker-large

# Model Gateway 超时与熔断（可选）
# LLM_TIMEOUT_SECONDS=60
# EMBEDDING_TIMEOUT_SECONDS=30
# RERANKER_TIMEOUT_SECONDS=30
# MODEL_GATEWAY_CB_THRESHOLD=5
# MODEL_GATEWAY_CB_SECONDS=60

# ----- 业务数据访问（多机构适配，T010a） -----
# 未配置时使用 Mock 适配器；配置后可使用 HTTP 机构适配器
# DATA_ACCESS_HTTP_BASE_URL=
# DATA_ACCESS_HTTP_API_KEY=
# DATA_ACCESS_HTTP_SOURCE_ORG=
# DATA_ACCESS_HTTP_TIMEOUT_SECONDS=30

# ----- 认证（T027a：账号+密码登录，JWT） -----
# 必填：Token 签发与校验密钥，至少 32 字符
JWT_SECRET=your-secret-at-least-32-chars
# 可选：Token 有效期（秒），默认 86400（24 小时）
# JWT_EXPIRES_SECONDS=86400

# ----- MinerU 文档解析（T031a：版面分析、表格/公式识别，供 ingestion 分块与向量化） -----
# 未配置时 parsing 调用 MinerU 将抛出 MinerUNotAvailable
# MINERU_ENDPOINT=http://localhost:9987

# ----- SSO/鉴权（可选，占位） -----
# SSO_ISSUER=
# SSO_JWKS_URI=
