# 生产环境变量模板
# 复制为 .env.production，填写实际值后使用

# ----- 应用 -----
APP_ENV=production
PORT=8000
LOG_LEVEL=INFO

# # ----- MySQL（生产环境） -----四川
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=tsp30dev
# MYSQL_PASSWORD=tsp30dev#123
# MYSQL_DATABASE=agent_dev01
# MYSQL_POOL_SIZE=20

# ----- MySQL（生产环境） -----四川
MYSQL_HOST=172.17.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=k2q3#k5f
MYSQL_DATABASE=fpai
MYSQL_POOL_SIZE=20


# ----- Redis（生产环境） -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_MAX_CONNECTIONS=50
REDIS_SESSION_TTL_SECONDS=1800
REDIS_PRODUCT_CACHE_TTL_SECONDS=600
REDIS_RETRIEVAL_CACHE_TTL_SECONDS=600
REDIS_RATELIMIT_WINDOW_SECONDS=60
REDIS_RATELIMIT_CHAT_MAX=60
REDIS_IDEMPOTENT_TTL_SECONDS=300

# ----- Milvus（生产环境） -----
MILVUS_HOST=<YOUR_PROD_MILVUS_HOST>
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=fpai_chunks

# ----- MinIO（生产环境） -----
MINIO_ENDPOINT=<YOUR_PROD_MINIO_ENDPOINT>
MINIO_ACCESS_KEY=<YOUR_PROD_MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<YOUR_PROD_MINIO_SECRET_KEY>
MINIO_BUCKET_DOCS=fpai-docs
MINIO_BUCKET_AUDIT=fpai-audit

# ----- LLM（大模型 API） -----
LLM_BASE_URL=<YOUR_PROD_LLM_BASE_URL>
LLM_API_KEY=<YOUR_PROD_LLM_API_KEY>
LLM_MODEL=qwen3-32b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=5000

# ----- Embedding -----
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=<YOUR_PROD_EMBEDDING_API_KEY>
EMBEDDING_MODEL=qwen3-vl-embedding

# ----- Reranker -----
RERANKER_BASE_URL=
RERANKER_API_KEY=<YOUR_PROD_RERANKER_API_KEY>
RERANKER_MODEL=qwen3-vl-rerank

# ----- JWT 密钥（生产环境必须修改） -----
JWT_SECRET=<YOUR_PROD_JWT_SECRET_32CHARS>

# ----- 外部知识库（生产环境） -----
EXTERNAL_KB_BASE_URL=http://host.docker.internal:8080
EXTERNAL_KB_LIST_URL=http://host.docker.internal:8080/api/v1/knowledge-bases
EXTERNAL_KB_API_KEY=sk-GUEJjzqCI8eWEseU0QXg3fKccABI0vF0PSYoWRZYQxwEuvMT

# ----- MinerU（可选） -----
# MINERU_ENDPOINT=<YOUR_PROD_MINERU_ENDPOINT>
